{
  "name": "sigil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:worklet && next dev",
    "build": "pnpm build:worklet && next build",
    "start": "next start",
    "build:worklet": "node scripts/build-worklet.mjs",
    "test": "NODE_OPTIONS=--expose-gc vitest run",
    "goldens": "node scripts/golden.mjs",
    "goldens:check": "node scripts/golden.mjs --check",
    "parity": "cmake -S native -B native/build && cmake --build native/build -j8 && ./native/build/sigil_parity",
    "test:watch": "NODE_OPTIONS=--expose-gc vitest",
    "desktop": "node scripts/desktop.mjs",
    "drift": "npm run goldens && npm run parity"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
